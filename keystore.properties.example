# Copy to keystore.properties (gitignored) to enable local release signing.
# Generate a keystore once and reuse it for every future release:
#   keytool -genkeypair -v -keystore anki-miner-release.jks -alias anki-miner \
#       -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/to/anki-miner-release.jks
storePassword=CHANGE_ME
keyAlias=anki-miner
keyPassword=CHANGE_ME
