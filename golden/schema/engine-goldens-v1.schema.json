{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-miner.invalid/schemas/engine-goldens-v1.schema.json",
  "title": "Anki Miner engine golden contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "unidic_feature_fields", "section_status", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "provenance": {"$ref": "#/$defs/provenance"},
    "unidic_feature_fields": {
      "type": "array",
      "prefixItems": [
        {"const": "pos1"},
        {"const": "pos2"},
        {"const": "pos3"},
        {"const": "pos4"},
        {"const": "cType"},
        {"const": "cForm"},
        {"const": "lForm"},
        {"const": "lemma"},
        {"const": "orth"},
        {"const": "pron"},
        {"const": "orthBase"},
        {"const": "pronBase"},
        {"const": "goshu"},
        {"const": "iType"},
        {"const": "iForm"},
        {"const": "fType"},
        {"const": "fForm"},
        {"const": "kana"},
        {"const": "kanaBase"},
        {"const": "form"},
        {"const": "formBase"},
        {"const": "iConType"},
        {"const": "fConType"},
        {"const": "aType"},
        {"const": "aConType"},
        {"const": "aModeType"}
      ],
      "items": false,
      "minItems": 26,
      "maxItems": 26
    },
    "section_status": {"$ref": "#/$defs/section_status"},
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenization",
        "morphology",
        "filtering",
        "deinflection",
        "compounds",
        "dictionaries",
        "frequency",
        "pitch",
        "cards"
      ],
      "properties": {
        "tokenization": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/tokenization_case"}
        },
        "morphology": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/morphology_case"}
        },
        "filtering": {"$ref": "#/$defs/inactive_cases"},
        "deinflection": {"$ref": "#/$defs/inactive_cases"},
        "compounds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/compound_case"}
        },
        "dictionaries": {"$ref": "#/$defs/inactive_cases"},
        "frequency": {"$ref": "#/$defs/inactive_cases"},
        "pitch": {"$ref": "#/$defs/inactive_cases"},
        "cards": {"$ref": "#/$defs/inactive_cases"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "tool", "runtime", "data"],
      "properties": {
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "tree_sha256"],
          "properties": {
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tree_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python_implementation",
            "python_version",
            "platform",
            "dependencies",
            "sha256"
          ],
          "properties": {
            "python_implementation": {"type": "string", "minLength": 1},
            "python_version": {"type": "string", "minLength": 1},
            "platform": {"type": "string", "minLength": 1},
            "dependencies": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/runtime_dependency"}
            },
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["corpus_sha256", "assets_sha256", "sha256"],
          "properties": {
            "corpus_sha256": {"$ref": "#/$defs/sha256"},
            "assets_sha256": {
              "type": "object",
              "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
              "additionalProperties": {"$ref": "#/$defs/sha256"}
            },
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "runtime_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "content_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "implemented_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {"state": {"const": "implemented"}}
    },
    "pending_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"const": "pending"},
        "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "section_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenization",
        "morphology",
        "filtering",
        "deinflection",
        "compounds",
        "dictionaries",
        "frequency",
        "pitch",
        "cards"
      ],
      "properties": {
        "tokenization": {"$ref": "#/$defs/implemented_status"},
        "morphology": {"$ref": "#/$defs/implemented_status"},
        "filtering": {"$ref": "#/$defs/pending_status"},
        "deinflection": {"$ref": "#/$defs/pending_status"},
        "compounds": {"$ref": "#/$defs/implemented_status"},
        "dictionaries": {"$ref": "#/$defs/pending_status"},
        "frequency": {"$ref": "#/$defs/pending_status"},
        "pitch": {"$ref": "#/$defs/pending_status"},
        "cards": {"$ref": "#/$defs/pending_status"}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pos1", "pos2", "pos3", "pos4", "cType", "cForm", "lForm",
        "lemma", "orth", "pron", "orthBase", "pronBase", "goshu",
        "iType", "iForm", "fType", "fForm", "kana", "kanaBase", "form",
        "formBase", "iConType", "fConType", "aType", "aConType", "aModeType"
      ],
      "properties": {
        "pos1": {"$ref": "#/$defs/feature_value"},
        "pos2": {"$ref": "#/$defs/feature_value"},
        "pos3": {"$ref": "#/$defs/feature_value"},
        "pos4": {"$ref": "#/$defs/feature_value"},
        "cType": {"$ref": "#/$defs/feature_value"},
        "cForm": {"$ref": "#/$defs/feature_value"},
        "lForm": {"$ref": "#/$defs/feature_value"},
        "lemma": {"$ref": "#/$defs/feature_value"},
        "orth": {"$ref": "#/$defs/feature_value"},
        "pron": {"$ref": "#/$defs/feature_value"},
        "orthBase": {"$ref": "#/$defs/feature_value"},
        "pronBase": {"$ref": "#/$defs/feature_value"},
        "goshu": {"$ref": "#/$defs/feature_value"},
        "iType": {"$ref": "#/$defs/feature_value"},
        "iForm": {"$ref": "#/$defs/feature_value"},
        "fType": {"$ref": "#/$defs/feature_value"},
        "fForm": {"$ref": "#/$defs/feature_value"},
        "kana": {"$ref": "#/$defs/feature_value"},
        "kanaBase": {"$ref": "#/$defs/feature_value"},
        "form": {"$ref": "#/$defs/feature_value"},
        "formBase": {"$ref": "#/$defs/feature_value"},
        "iConType": {"$ref": "#/$defs/feature_value"},
        "fConType": {"$ref": "#/$defs/feature_value"},
        "aType": {"$ref": "#/$defs/feature_value"},
        "aConType": {"$ref": "#/$defs/feature_value"},
        "aModeType": {"$ref": "#/$defs/feature_value"}
      }
    },
    "feature_value": {
      "anyOf": [
        {"type": "string", "not": {"const": "*"}},
        {"type": "null"}
      ]
    },
    "offsets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codepoint_start", "codepoint_end", "utf16_start", "utf16_end"],
      "properties": {
        "codepoint_start": {"type": "integer", "minimum": 0},
        "codepoint_end": {"type": "integer", "minimum": 0},
        "utf16_start": {"type": "integer", "minimum": 0},
        "utf16_end": {"type": "integer", "minimum": 0}
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "is_unknown", "offsets", "features"],
      "properties": {
        "surface": {"type": "string", "minLength": 1},
        "is_unknown": {"type": "boolean"},
        "offsets": {"$ref": "#/$defs/offsets"},
        "features": {"$ref": "#/$defs/features"}
      }
    },
    "tokenization_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "tokens"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "text": {"type": "string"},
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "lemma",
        "orth_base",
        "mined_form",
        "reading",
        "pos",
        "surface_start",
        "surface_end",
        "highlight_end",
        "sentence",
        "expression_furigana",
        "expression_reading",
        "sentence_furigana",
        "sentence_reading"
      ],
      "properties": {
        "surface": {"type": "string"},
        "lemma": {"type": "string"},
        "orth_base": {"type": "string"},
        "mined_form": {"type": "string"},
        "reading": {"type": "string"},
        "pos": {"type": "string"},
        "surface_start": {"type": "integer", "minimum": 0},
        "surface_end": {"type": "integer", "minimum": 0},
        "highlight_end": {"type": "integer", "minimum": 0},
        "sentence": {"type": "string"},
        "expression_furigana": {"type": "string"},
        "expression_reading": {"type": "string"},
        "sentence_furigana": {"type": "string"},
        "sentence_reading": {"type": "string"}
      }
    },
    "word_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["words"],
      "properties": {
        "words": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/word"}
        }
      }
    },
    "morphology_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "output"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {"text": {"type": "string"}}
        },
        "output": {"$ref": "#/$defs/word_output"}
      }
    },
    "compound_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "output"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "dictionary_terms"],
          "properties": {
            "text": {"type": "string"},
            "dictionary_terms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "output": {"$ref": "#/$defs/word_output"}
      }
    },
    "inactive_cases": {
      "type": "array",
      "maxItems": 0
    }
  }
}
