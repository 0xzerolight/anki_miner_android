{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-miner.app/schemas/android-bridge/v1/mining.json",
  "title": "Anki Miner Android mining messages",
  "$comment": "This schema validates complete bridge envelopes so a payload valid for one operation cannot be paired with another message type. protocol.decode_envelope first rejects duplicate keys, non-finite numbers, integers outside signed 64-bit, invalid Unicode scalars, and overlong numeric tokens. configSnapshot is additionally frozen by the shared config-snapshot schema. The reading runtime also caps its complete request at 1 MiB after strict UTF-8 encoding.",
  "oneOf": [
    {"$ref": "#/$defs/videoRunMessage"},
    {"$ref": "#/$defs/readingRunMessage"},
    {"$ref": "#/$defs/jobRegistrationRequestMessage"},
    {"$ref": "#/$defs/jobRegistrationAcceptedMessage"},
    {"$ref": "#/$defs/terminalMessage"},
    {"$ref": "#/$defs/languageProfilesRequestMessage"},
    {"$ref": "#/$defs/languageProfilesResultMessage"}
  ],
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "canonicalLabel": {
      "type": "string",
      "minLength": 1,
      "$comment": "Runtime validation additionally enforces NFC and rejects every Unicode category-C code point.",
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]).+$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\u0000)/"
    },
    "subtitlePath": {
      "allOf": [
        {"$ref": "#/$defs/absolutePath"},
        {"pattern": "\\.(?:[aA][sS][sS]|[sS][rR][tT]|[sS][sS][aA]|[vV][tT][tT])$"}
      ]
    },
    "privateReadingPath": {
      "allOf": [
        {"$ref": "#/$defs/absolutePath"},
        {
          "maxLength": 4096,
          "$comment": "Runtime validation applies a stricter 4096-byte UTF-8 ceiling and requires source/archive paths to resolve inside stagingRoot."
        }
      ]
    },
    "readingSourcePath": {
      "allOf": [
        {"$ref": "#/$defs/privateReadingPath"},
        {"pattern": "\\.(?:[tT][xX][tT]|[tT][eE][xX][tT]|[eE][pP][uU][bB]|[mM][oO][kK][uU][rR][oO]|[aA][sS][sS]|[sS][rR][tT]|[sS][sS][aA]|[vV][tT][tT])$"}
      ]
    },
    "readingArchivePath": {
      "allOf": [
        {"$ref": "#/$defs/privateReadingPath"},
        {"pattern": "\\.(?:[cC][bB][zZ]|[zZ][iI][pP])$"}
      ]
    },
    "nonNegativeSigned64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positiveSigned64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "processingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalWordsFound",
        "newWordsFound",
        "cardsCreated",
        "errors",
        "elapsedTime",
        "comprehensionPercentage",
        "cardIds",
        "videoFile",
        "subtitleFile",
        "minedForms",
        "minedFormsLanguage",
        "ankiWriteState",
        "failureIsTransient",
        "notMined"
      ],
      "properties": {
        "totalWordsFound": {"$ref": "#/$defs/nonNegativeSigned64"},
        "newWordsFound": {"$ref": "#/$defs/nonNegativeSigned64"},
        "cardsCreated": {
          "$ref": "#/$defs/nonNegativeSigned64",
          "$comment": "Legacy wire name: this is the count of successfully inserted Anki notes, not the number of generated card rows."
        },
        "errors": {
          "type": "array",
          "$comment": "Desktop AnkiMinerException text is preserved verbatim and may be empty.",
          "items": {"type": "string"}
        },
        "elapsedTime": {
          "type": "number",
          "$comment": "Wall-clock adjustments can make the desktop duration negative; protocol decoding rejects NaN and infinity before schema validation."
        },
        "comprehensionPercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "cardIds": {
          "type": "array",
          "uniqueItems": true,
          "$comment": "Legacy wire name: these are the corresponding positive Anki note IDs from last_created_note_ids, including any proven partial inserts.",
          "items": {"$ref": "#/$defs/positiveSigned64"}
        },
        "videoFile": {"type": "string"},
        "subtitleFile": {"type": "string"},
        "minedForms": {
          "type": "array",
          "items": {"type": "string"}
        },
        "minedFormsLanguage": {
          "type": "string",
          "pattern": "^$|^[a-z]{2,3}$",
          "$comment": "The mining language whose known-words database holds minedForms' rows; Undo reverts them there after a language switch. Empty when the engine did not stamp it (every result but a completed one), and Undo falls back to the live language."
        },
        "ankiWriteState": {
          "enum": ["no_note_write", "note_write_uncertain", "note_write_confirmed"],
          "$comment": "Engine D30 note-write provenance. Only no_note_write proves nothing reached the collection; the engine fails closed to note_write_uncertain."
        },
        "failureIsTransient": {
          "type": "boolean",
          "$comment": "Always false on Android: the engine classifier only recognizes an AnkiConnectionError caused by a requests transport error, and the ContentProvider adapter never raises through that path. Carried for wire fidelity; not a retry signal here."
        },
        "notMined": {
          "type": ["array", "null"],
          "items": {"$ref": "#/$defs/notMinedGroup"},
          "$comment": "The engine NotMinedReport: why words the run saw made no card. Null from anything that never ran the pipeline. One group per reason that names a form, in the engine's NotMinedReason declaration order; a mined form is never listed and known outranks every other reason (NotMinedReport.forms). Kotlin additionally rejects a reason that appears twice."
        }
      }
    },
    "notMinedGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "forms"],
      "properties": {
        "reason": {
          "enum": [
            "word_type",
            "sound_effect",
            "kana_only",
            "script",
            "known",
            "no_definition",
            "unranked",
            "frequency",
            "blacklist",
            "script_filter",
            "name_list",
            "occurrence",
            "one_per_sentence",
            "i_plus_one",
            "sentence_length",
            "same_card",
            "media_failed",
            "anki_duplicate",
            "anki_failed"
          ],
          "$comment": "NotMinedReason values in declaration order; test_schemas pins this list to the vendored engine."
        },
        "forms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"},
          "$comment": "Card fronts, sorted by code point."
        }
      }
    },
    "terminalError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "message": {
          "type": "string",
          "$comment": "result_error_text preserves a possibly empty desktop error string verbatim; Kotlin supplies any display fallback. For code resources_stale it carries only the stale resources' names as the engine quoted them; Kotlin renders the sentence from its catalogs."
        },
        "faultId": {
          "type": "string",
          "pattern": "^f[0-9a-f]{8}$",
          "$comment": "Optional opaque key joining this terminal to the traceback logged on device. Absent on cancelled and cleanup_failed terminals, which are not faults."
        }
      }
    },
    "videoRunPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "videoPath",
        "subtitlePath",
        "secondarySubtitlePath",
        "secondarySubtitleOffsetMs",
        "episodeName",
        "seriesName",
        "sourceLabel",
        "audioTrackOverride",
        "audioOnly",
        "cacheDir",
        "nativeLibraryDir",
        "configSnapshot"
      ],
      "properties": {
        "videoPath": {"$ref": "#/$defs/absolutePath"},
        "subtitlePath": {"$ref": "#/$defs/subtitlePath"},
        "secondarySubtitlePath": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/subtitlePath"}
          ],
          "$comment": "A second, staged subtitle track (desktop F7). Null when the Video tab sent none."
        },
        "secondarySubtitleOffsetMs": {
          "type": "integer",
          "minimum": -300000,
          "maximum": 300000,
          "$comment": "Signed shift of the secondary track in milliseconds; desktop bounds it to plus or minus 300 s. Inert while secondarySubtitlePath is null."
        },
        "episodeName": {"$ref": "#/$defs/canonicalLabel"},
        "seriesName": {"$ref": "#/$defs/canonicalLabel"},
        "sourceLabel": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/canonicalLabel"}
          ]
        },
        "audioTrackOverride": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonNegativeSigned64"}
          ]
        },
        "audioOnly": {"type": "boolean"},
        "cacheDir": {"$ref": "#/$defs/absolutePath"},
        "nativeLibraryDir": {"$ref": "#/$defs/absolutePath"},
        "configSnapshot": {
          "allOf": [
            {"$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json"},
            {"required": ["settings"]}
          ]
        }
      }
    },
    "readingRunPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "sourcePath",
        "imageArchivePath",
        "seriesName",
        "stagingRoot",
        "cacheDir",
        "nativeLibraryDir",
        "configSnapshot"
      ],
      "properties": {
        "sourceKind": {"enum": ["txt", "text", "epub", "subtitle", "mokuro"]},
        "sourcePath": {"$ref": "#/$defs/readingSourcePath"},
        "imageArchivePath": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/readingArchivePath"}
          ]
        },
        "seriesName": {
          "oneOf": [
            {"type": "null"},
            {
              "allOf": [
                {"$ref": "#/$defs/canonicalLabel"},
                {"maxLength": 1024}
              ]
            }
          ]
        },
        "stagingRoot": {"$ref": "#/$defs/absolutePath"},
        "cacheDir": {"$ref": "#/$defs/absolutePath"},
        "nativeLibraryDir": {"$ref": "#/$defs/absolutePath"},
        "configSnapshot": {
          "allOf": [
            {"$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json"},
            {"required": ["settings"]}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"sourceKind": {"const": "txt"}}},
          "then": {"properties": {"sourcePath": {"pattern": "\\.[tT][xX][tT]$"}, "imageArchivePath": {"type": "null"}, "seriesName": {"type": "null"}}}
        },
        {
          "if": {"properties": {"sourceKind": {"const": "text"}}},
          "then": {"properties": {"sourcePath": {"pattern": "\\.[tT][eE][xX][tT]$"}, "imageArchivePath": {"type": "null"}, "seriesName": {"type": "null"}}}
        },
        {
          "if": {"properties": {"sourceKind": {"const": "epub"}}},
          "then": {"properties": {"sourcePath": {"pattern": "\\.[eE][pP][uU][bB]$"}, "imageArchivePath": {"type": "null"}, "seriesName": {"type": "null"}}}
        },
        {
          "if": {"properties": {"sourceKind": {"const": "subtitle"}}},
          "then": {"properties": {"sourcePath": {"pattern": "\\.(?:[aA][sS][sS]|[sS][rR][tT]|[sS][sS][aA]|[vV][tT][tT])$"}, "imageArchivePath": {"type": "null"}, "seriesName": {"$ref": "#/$defs/canonicalLabel"}}}
        },
        {
          "if": {"properties": {"sourceKind": {"const": "mokuro"}}},
          "then": {"properties": {"sourcePath": {"pattern": "\\.[mM][oO][kK][uU][rR][oO]$"}, "seriesName": {"type": "null"}}}
        }
      ],
      "$comment": "Runtime validation additionally requires sourcePath and imageArchivePath to resolve inside stagingRoot, the private stage under noBackupFilesDir. A non-null archive is only accepted for mokuro and must be an existing same-directory, same-stem companion selected by the desktop detector. seriesName is a stable Kotlin-owned subtitle label which replaces the loader's nonce job-directory-derived series; it is null for every other kind."
    },
    "registrationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"}
      }
    },
    "terminalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "outcome", "result", "error"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "outcome": {"enum": ["success", "cancelled", "failed"]},
        "result": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/processingResult"}
          ]
        },
        "error": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/terminalError"}
          ]
        }
      },
      "oneOf": [
        {
          "$comment": "The desktop classifier reports success only for a ProcessingResult with no list errors.",
          "properties": {
            "outcome": {"const": "success"},
            "result": {
              "allOf": [
                {"$ref": "#/$defs/processingResult"},
                {"properties": {"errors": {"maxItems": 0}}}
              ]
            },
            "error": {"type": "null"}
          }
        },
        {
          "$comment": "A non-raising engine cancellation retains its full partial ProcessingResult and has no separate terminal error.",
          "properties": {
            "outcome": {"const": "cancelled"},
            "result": {
              "allOf": [
                {"$ref": "#/$defs/processingResult"},
                {
                  "properties": {
                    "errors": {
                      "contains": {"const": "Processing cancelled by user"}
                    }
                  }
                }
              ]
            },
            "error": {"type": "null"}
          }
        },
        {
          "$comment": "Cancellation raised by the synchronous Anki callback seam has no ProcessingResult.",
          "properties": {
            "outcome": {"const": "cancelled"},
            "result": {"type": "null"},
            "error": {
              "allOf": [
                {"$ref": "#/$defs/terminalError"},
                {"properties": {"code": {"const": "cancelled"}}}
              ]
            }
          }
        },
        {
          "$comment": "A regular failed return either retains its non-cancellation errors or is the desktop None-result failure.",
          "properties": {
            "outcome": {"const": "failed"},
            "result": {
              "oneOf": [
                {"type": "null"},
                {
                  "allOf": [
                    {"$ref": "#/$defs/processingResult"},
                    {
                      "properties": {
                        "errors": {
                          "minItems": 1,
                          "not": {
                            "contains": {"const": "Processing cancelled by user"}
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "error": {
              "allOf": [
                {"$ref": "#/$defs/terminalError"},
                {"properties": {"code": {"const": "processing_failed"}}}
              ]
            }
          }
        },
        {
          "$comment": "Post-process cleanup failure retains whatever complete ProcessingResult the engine produced.",
          "properties": {
            "outcome": {"const": "failed"},
            "result": {"$ref": "#/$defs/processingResult"},
            "error": {
              "allOf": [
                {"$ref": "#/$defs/terminalError"},
                {"properties": {"code": {"const": "cleanup_failed"}}}
              ]
            }
          }
        },
        {
          "$comment": "Raised protocol, engine-domain, and internal failures never fabricate a ProcessingResult.",
          "properties": {
            "outcome": {"const": "failed"},
            "result": {"type": "null"},
            "error": {
              "allOf": [
                {"$ref": "#/$defs/terminalError"},
                {
                  "properties": {
                    "code": {
                      "not": {
                        "enum": ["processing_failed", "cleanup_failed", "cancelled"]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "videoRunMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": {"const": 1},
        "type": {"const": "mining.video.run"},
        "payload": {"$ref": "#/$defs/videoRunPayload"}
      }
    },
    "readingRunMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": {"const": 1},
        "type": {"const": "mining.reading.run"},
        "payload": {"$ref": "#/$defs/readingRunPayload"}
      }
    },
    "jobRegistrationRequestMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": {"const": 1},
        "type": {"const": "job.registration.request"},
        "payload": {"$ref": "#/$defs/registrationPayload"}
      }
    },
    "jobRegistrationAcceptedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": {"const": 1},
        "type": {"const": "job.registration.accepted"},
        "payload": {"$ref": "#/$defs/registrationPayload"}
      }
    },
    "terminalMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "payload"],
      "properties": {
        "schemaVersion": {"const": 1},
        "type": {"const": "mining.terminal"},
        "payload": {"$ref": "#/$defs/terminalPayload"}
      }
    },
    "languageCode": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "logicalKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "scopedDefaults": {
      "type": "object",
      "$comment": "A profile's first-visit value for each LANGUAGE_SCOPED_FIELDS name config_map exposes, in the settings-snapshot shape. The two desktop downloader fields are not exposed.",
      "additionalProperties": false,
      "required": [
        "dictionary_chain",
        "frequency_chain",
        "pitch_chain",
        "expression_audio_chain",
        "allowed_pos",
        "excluded_subtypes",
        "excluded_wordsets",
        "exclude_hiragana_only_words",
        "exclude_katakana_only_words",
        "known_words_match_kana_variants",
        "anki_fields",
        "anki_deck_name",
        "anki_note_type",
        "card_type",
        "blacklist_path",
        "whitelist_path",
        "use_blacklist",
        "use_whitelist",
        "excluded_decks",
        "script_variant",
        "reading_tone_color",
        "use_subtitle_regex_filter",
        "subtitle_regex_filter",
        "subtitle_regex_replacement",
        "min_frequency_rank",
        "max_frequency_rank",
        "frequency_keep_unranked",
        "pitch_category_format",
        "card_type_marker_fields",
        "max_sentence_chars"
      ],
      "properties": {
        "dictionary_chain": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/dictionary_chain"
        },
        "frequency_chain": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/frequency_chain"
        },
        "pitch_chain": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/pitch_chain"
        },
        "expression_audio_chain": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/expression_audio_chain"
        },
        "allowed_pos": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/allowed_pos"
        },
        "excluded_subtypes": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/excluded_subtypes"
        },
        "excluded_wordsets": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/excluded_wordsets"
        },
        "exclude_hiragana_only_words": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/exclude_hiragana_only_words"
        },
        "exclude_katakana_only_words": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/exclude_katakana_only_words"
        },
        "known_words_match_kana_variants": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/known_words_match_kana_variants"
        },
        "anki_fields": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/anki_fields"
        },
        "anki_deck_name": {
          "type": "string"
        },
        "anki_note_type": {
          "type": "string",
          "$comment": "Blank for every profile: the user must pick a note type before a run, and config_map refuses a blank one."
        },
        "card_type": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/card_type"
        },
        "blacklist_path": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/blacklist_path"
        },
        "whitelist_path": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/whitelist_path"
        },
        "use_blacklist": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/use_blacklist"
        },
        "use_whitelist": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/use_whitelist"
        },
        "excluded_decks": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/excluded_decks"
        },
        "script_variant": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/script_variant"
        },
        "reading_tone_color": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/reading_tone_color"
        },
        "use_subtitle_regex_filter": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/use_subtitle_regex_filter"
        },
        "subtitle_regex_filter": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/subtitle_regex_filter"
        },
        "subtitle_regex_replacement": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/subtitle_regex_replacement"
        },
        "min_frequency_rank": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/min_frequency_rank"
        },
        "max_frequency_rank": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/max_frequency_rank"
        },
        "frequency_keep_unranked": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/frequency_keep_unranked"
        },
        "pitch_category_format": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/pitch_category_format"
        },
        "card_type_marker_fields": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/card_type_marker_fields"
        },
        "max_sentence_chars": {
          "$ref": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json#/$defs/settings/properties/max_sentence_chars"
        }
      }
    },
    "extraCardField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "capability",
        "placeholder",
        "rawHtml"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/logicalKey"
        },
        "capability": {
          "$ref": "#/$defs/logicalKey"
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        },
        "rawHtml": {
          "type": "boolean"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "$comment": "Other Anki field names that map to this key (CardFieldSpec.aliases). The bridge always sends it; absent reads as none."
        }
      }
    },
    "languageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "displayName",
        "englishName",
        "unavailableReason",
        "scriptVariants",
        "contentDirection",
        "contentLanguage",
        "speechLanguage",
        "audioTrackCodes",
        "capabilities",
        "requiresUnidic",
        "scopedDefaults",
        "extraCardFields"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/languageCode"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "englishName": {
          "type": "string",
          "minLength": 1
        },
        "unavailableReason": {
          "enum": [
            null,
            "language_data_required",
            "language_unsupported"
          ],
          "$comment": "An Android reason code; the engine's own sentence names desktop menus and never crosses."
        },
        "scriptVariants": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "items": {
            "enum": [
              "",
              "simplified",
              "traditional",
              "br",
              "pt"
            ]
          }
        },
        "contentDirection": {
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "contentLanguage": {
          "$ref": "#/$defs/languageCode"
        },
        "speechLanguage": {
          "$ref": "#/$defs/languageCode"
        },
        "audioTrackCodes": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/logicalKey"
          }
        },
        "requiresUnidic": {
          "type": "boolean"
        },
        "scopedDefaults": {
          "$ref": "#/$defs/scopedDefaults"
        },
        "extraCardFields": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/extraCardField"
          }
        }
      }
    },
    "languageProfilesRequestMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "language.profiles"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "languageProfilesResultMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "language.profiles.result"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profiles"
          ],
          "properties": {
            "profiles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/languageProfile"
              }
            }
          }
        }
      }
    }
  }
}
