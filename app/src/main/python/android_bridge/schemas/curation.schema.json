{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-miner.app/schemas/android-bridge/v1/curation.json",
  "title": "Anki Miner Android curation request or response payload",
  "$comment": "Small curation keeps the legacy request/response shapes. Runtime paging uses at most 100 candidates and at most 524288 UTF-8 bytes per request envelope; candidates are never truncated. Known-word marks travel as opaque candidate IDs, accumulate across pages, and are written once when the final page resolves.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/pageRequest"},
    {"$ref": "#/$defs/pageResponse"},
    {"$ref": "#/$defs/accepted"},
    {"$ref": "#/$defs/pageAccepted"}
  ],
  "$defs": {
    "runId": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "requestId": {"type": "string", "pattern": "^curation_[0-9a-f]{32}$"},
    "candidateId": {"type": "string", "pattern": "^candidate_[0-9a-f]{32}$"},
    "sentenceId": {"type": "string", "pattern": "^sentence_[0-9a-f]{32}$"},
    "signed64": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
    "nonNegativeSigned64": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveSigned64": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentenceId", "sentence", "sentenceFurigana", "sentenceReading", "startTime", "endTime", "duration"],
      "properties": {
        "sentenceId": {"$ref": "#/$defs/sentenceId"},
        "sentence": {"type": "string"},
        "sentenceFurigana": {"type": "string"},
        "sentenceReading": {"type": "string"},
        "startTime": {"type": "number"},
        "endTime": {"type": "number"},
        "duration": {"type": "number"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/candidateId"},
        "sentenceId": {"$ref": "#/$defs/sentenceId"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId", "minedForm", "surface", "lemma", "reading",
        "expressionReading", "partOfSpeech", "frequencyRank", "occurrenceCount",
        "defaultSentenceId", "sentences"
      ],
      "properties": {
        "candidateId": {"$ref": "#/$defs/candidateId"},
        "minedForm": {"type": "string"},
        "surface": {"type": "string"},
        "lemma": {"type": "string"},
        "reading": {"type": "string"},
        "expressionReading": {"type": "string"},
        "partOfSpeech": {"type": ["string", "null"]},
        "frequencyRank": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/signed64"}
          ]
        },
        "occurrenceCount": {"$ref": "#/$defs/nonNegativeSigned64"},
        "defaultSentenceId": {"$ref": "#/$defs/sentenceId"},
        "sentences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sentence"}}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "candidates"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "candidates": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/candidate"}}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "selection"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "selection": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/selection"}}
          ]
        },
        "knownCandidateIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidateId"}
        }
      }
    },
    "pageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId", "requestId", "pageIndex", "pageCount", "candidateStart",
        "totalCandidates", "candidates"
      ],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "pageIndex": {"$ref": "#/$defs/nonNegativeSigned64"},
        "pageCount": {"type": "integer", "minimum": 2, "maximum": 9223372036854775807},
        "candidateStart": {"$ref": "#/$defs/nonNegativeSigned64"},
        "totalCandidates": {"type": "integer", "minimum": 2, "maximum": 9223372036854775807},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/candidate"}
        }
      },
      "$comment": "Runtime validation enforces pageIndex < pageCount, contiguous candidateStart values, and that only the final page reaches totalCandidates."
    },
    "pageResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "pageIndex", "selection"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "pageIndex": {"$ref": "#/$defs/nonNegativeSigned64"},
        "selection": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/selection"}}
          ]
        },
        "knownCandidateIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidateId"}
        }
      }
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"}
      }
    },
    "pageAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "pageIndex", "finalPage"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "pageIndex": {"$ref": "#/$defs/nonNegativeSigned64"},
        "finalPage": {"type": "boolean"}
      }
    }
  }
}
