{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-miner.app/schemas/android-bridge/v1/curation.json",
  "title": "Anki Miner Android curation payloads",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"}
  ],
  "$defs": {
    "opaqueId": {"type": "string", "minLength": 8},
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentenceId", "sentence", "sentenceFurigana", "sentenceReading", "startTime", "endTime", "duration"],
      "properties": {
        "sentenceId": {"$ref": "#/$defs/opaqueId"},
        "sentence": {"type": "string"},
        "sentenceFurigana": {"type": "string"},
        "sentenceReading": {"type": "string"},
        "startTime": {"type": "number"},
        "endTime": {"type": "number"},
        "duration": {"type": "number"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/opaqueId"},
        "sentenceId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId", "minedForm", "surface", "lemma", "reading",
        "expressionReading", "partOfSpeech", "frequencyRank", "occurrenceCount",
        "defaultSentenceId", "sentences"
      ],
      "properties": {
        "candidateId": {"$ref": "#/$defs/opaqueId"},
        "minedForm": {"type": "string"},
        "surface": {"type": "string"},
        "lemma": {"type": "string"},
        "reading": {"type": "string"},
        "expressionReading": {"type": "string"},
        "partOfSpeech": {"type": ["string", "null"]},
        "frequencyRank": {"type": ["integer", "null"]},
        "occurrenceCount": {"type": "integer"},
        "defaultSentenceId": {"$ref": "#/$defs/opaqueId"},
        "sentences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sentence"}}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "candidates"],
      "properties": {
        "runId": {"$ref": "#/$defs/opaqueId"},
        "requestId": {"$ref": "#/$defs/opaqueId"},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "selection"],
      "properties": {
        "runId": {"$ref": "#/$defs/opaqueId"},
        "requestId": {"$ref": "#/$defs/opaqueId"},
        "selection": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"$ref": "#/$defs/selection"}}
          ]
        }
      }
    }
  }
}
