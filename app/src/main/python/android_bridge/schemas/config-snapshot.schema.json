{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-miner.app/schemas/android-bridge/v1/config-snapshot.json",
  "title": "Anki Miner Android config.snapshot payload",
  "$comment": "Provider identity uniqueness is a runtime semantic refinement: uniqueItems rejects identical objects, while config_map also rejects the same dict_id, source_id, or pack_id with different enabled values.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "androidTtsEnabled": {"type": "boolean"},
    "settings": {"$ref": "#/$defs/settings"}
  },
  "$defs": {
    "resourceId": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9_-])?$"
    },
    "canonicalNonEmptyString": {
      "type": "string",
      "minLength": 1,
      "$comment": "Runtime validation additionally enforces NFC and rejects every Unicode category-C code point.",
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]).+$"
    },
    "optionalMappedField": {
      "oneOf": [
        {"const": ""},
        {"$ref": "#/$defs/canonicalNonEmptyString"}
      ]
    },
    "absolutePathOrNull": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^/"}
      ]
    },
    "ankiFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "word": {"$ref": "#/$defs/optionalMappedField"},
        "sentence": {"$ref": "#/$defs/optionalMappedField"},
        "definition": {"$ref": "#/$defs/optionalMappedField"},
        "glossary": {"$ref": "#/$defs/optionalMappedField"},
        "picture": {"$ref": "#/$defs/optionalMappedField"},
        "audio": {"$ref": "#/$defs/optionalMappedField"},
        "expression_furigana": {"$ref": "#/$defs/optionalMappedField"},
        "expression_reading": {"$ref": "#/$defs/optionalMappedField"},
        "sentence_furigana": {"$ref": "#/$defs/optionalMappedField"},
        "sentence_reading": {"$ref": "#/$defs/optionalMappedField"},
        "pitch_position": {"$ref": "#/$defs/optionalMappedField"},
        "pitch_category": {"$ref": "#/$defs/optionalMappedField"},
        "pitch_graph": {"$ref": "#/$defs/optionalMappedField"},
        "pitch_text": {"$ref": "#/$defs/optionalMappedField"},
        "frequency": {"$ref": "#/$defs/optionalMappedField"},
        "frequency_sort": {"$ref": "#/$defs/optionalMappedField"},
        "source": {"$ref": "#/$defs/optionalMappedField"},
        "expression_audio": {"$ref": "#/$defs/optionalMappedField"}
      }
    },
    "cardTypeMarkerFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "word_and_sentence": {"$ref": "#/$defs/optionalMappedField"},
        "click": {"$ref": "#/$defs/optionalMappedField"},
        "sentence": {"$ref": "#/$defs/optionalMappedField"},
        "audio": {"$ref": "#/$defs/optionalMappedField"}
      }
    },
    "indexedDictionary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dict_id"],
      "properties": {
        "kind": {"const": "indexed"},
        "dict_id": {"$ref": "#/$defs/resourceId"},
        "enabled": {"type": "boolean"}
      }
    },
    "jishoDictionary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "jisho"},
        "dict_id": {"type": "null"},
        "enabled": {"type": "boolean"}
      }
    },
    "pitchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": {"$ref": "#/$defs/resourceId"},
        "enabled": {"type": "boolean"}
      }
    },
    "frequencySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": {"$ref": "#/$defs/resourceId"},
        "enabled": {"type": "boolean"}
      }
    },
    "audioPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pack_id"],
      "properties": {
        "kind": {"const": "pack"},
        "pack_id": {"$ref": "#/$defs/resourceId"},
        "enabled": {"type": "boolean"}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anki_deck_name": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "anki_note_type": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "anki_fields": {"$ref": "#/$defs/ankiFields"},
        "card_type": {"enum": ["", "word_and_sentence", "click", "sentence", "audio"]},
        "card_type_marker_fields": {"$ref": "#/$defs/cardTypeMarkerFields"},
        "anki_tags": {"type": "string"},
        "excluded_decks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalNonEmptyString"}
        },
        "audio_padding": {"type": "number", "minimum": 0},
        "screenshot_offset": {"type": "number", "minimum": 0},
        "audio_format": {"enum": ["mp3", "opus"]},
        "audio_bitrate": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "screenshot_animated": {
          "type": "boolean",
          "description": "Extract a short looping clip instead of a static JPEG"
        },
        "screenshot_animated_format": {
          "enum": ["avif", "webp"],
          "description": "Resolved by Kotlin from the device MIME table, not chosen by the user"
        },
        "screenshot_animated_clip_duration": {"type": "number", "minimum": 0.5, "maximum": 10},
        "screenshot_animated_quality": {"type": "integer", "minimum": 0, "maximum": 100},
        "screenshot_animated_match_audio": {
          "type": "boolean",
          "description": "Clip spans the padded audio window; overrides screenshot_animated_clip_duration"
        },
        "subtitle_offset": {"type": "number"},
        "allowed_pos": {"type": "array", "items": {"type": "string"}},
        "excluded_subtypes": {"type": "array", "items": {"type": "string"}},
        "excluded_wordsets": {"type": "array", "items": {"type": "string"}},
        "dictionary_chain": {
          "type": "array",
          "uniqueItems": true,
          "items": {"oneOf": [{"$ref": "#/$defs/indexedDictionary"}, {"$ref": "#/$defs/jishoDictionary"}]}
        },
        "jisho_delay": {"type": "number", "minimum": 0.5},
        "expression_audio_chain": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/audioPack"}
        },
        "reading_tts_enabled": {
          "type": "boolean",
          "description": "Legacy Android-only alias; never assigned to the engine config"
        },
        "pitch_category_format": {"enum": ["jp", "romaji"]},
        "max_frequency_rank": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "frequency_chain": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/frequencySource"}
        },
        "pitch_chain": {
          "type": "array",
          "uniqueItems": true,
          "$comment": "First-hit-wins pitch chain; each entry names a per-source index under the pitch root.",
          "items": {"$ref": "#/$defs/pitchSource"}
        },
        "use_known_words_db": {"type": "boolean"},
        "exclude_hiragana_only_words": {"type": "boolean"},
        "exclude_katakana_only_words": {"type": "boolean"},
        "blacklist_path": {"$ref": "#/$defs/absolutePathOrNull"},
        "whitelist_path": {"$ref": "#/$defs/absolutePathOrNull"},
        "use_blacklist": {"type": "boolean"},
        "use_whitelist": {"type": "boolean"},
        "subtitle_regex_filter": {"type": "string"},
        "subtitle_regex_replacement": {"type": "string"},
        "use_subtitle_regex_filter": {"type": "boolean"},
        "strip_subtitle_annotations": {"type": "boolean"},
        "bold_target_in_sentence": {"type": "boolean"},
        "deduplicate_sentences": {"type": "boolean"},
        "use_i_plus_one_filter": {"type": "boolean"},
        "use_sentence_length_filter": {"type": "boolean"},
        "max_sentence_duration_seconds": {"type": "number", "minimum": 0},
        "max_sentence_chars": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "reading_min_occurrence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "max_parallel_workers": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    }
  }
}
