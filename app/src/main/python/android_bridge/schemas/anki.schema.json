{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-miner.app/schemas/android-bridge/v1/anki.json",
  "title": "Anki Miner Android AnkiDroid callback payloads",
  "$comment": "Every callback is synchronous and returns an envelope. Responses repeat runId/requestId; media and note results are positionally aligned with requests. verifyTarget validates model/fields before creating the deck. Duplicate scans are bounded candidate-key lookups, never full-model scans. preferredName is the extensionless prefix required by AnkiDroid addMediaFromUri; actualFilename is a raw basename, never [sound:] or <img> markup, and Python rewrites marked dictionary HTML to the provider-returned name. Runtime validation additionally enforces provider-name relationships and collisions, unique positive note IDs, and a strict notAttempted suffix with a top-level error.",
  "oneOf": [
    {"$ref": "#/$defs/verifyTargetRequest"},
    {"$ref": "#/$defs/verifyTargetResult"},
    {"$ref": "#/$defs/scanFirstFieldsRequest"},
    {"$ref": "#/$defs/scanFirstFieldsResult"},
    {"$ref": "#/$defs/duplicateLookupResult"},
    {"$ref": "#/$defs/storeMediaRequest"},
    {"$ref": "#/$defs/storeMediaResult"},
    {"$ref": "#/$defs/createNotesRequest"},
    {"$ref": "#/$defs/createNotesResult"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "runId": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "requestId": {"type": "string", "pattern": "^anki_[0-9a-f]{32}$"},
    "assetId": {"type": "string", "pattern": "^asset_[0-9a-f]{32}$"},
    "clientNoteId": {"type": "string", "pattern": "^note_[0-9a-f]{32}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "canonicalNonEmptyString": {
      "type": "string",
      "minLength": 1,
      "$comment": "Runtime validation additionally enforces NFC and rejects every Unicode category-C code point.",
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]).+$"
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "$comment": "Runtime validation additionally enforces NFC, bare-basename semantics, and rejects every Unicode category-C code point.",
      "pattern": "^(?![.]{1,2}$)(?!\\s)(?!.*\\s$)(?!.*[/\\\\<>\\[\\]:\"'\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]).+$"
    },
    "duplicateKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "errorCode": {
      "enum": [
        "api_disabled",
        "permission_required",
        "note_type_not_found",
        "field_missing",
        "field_mapping_invalid",
        "target_invalid",
        "provider_unavailable",
        "query_failed",
        "write_failed",
        "timeout",
        "cancelled",
        "media_store_failed",
        "invalid_request",
        "unsupported_operation",
        "internal_error"
      ]
    },
    "errorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"$ref": "#/$defs/errorCode"},
        "message": {"$ref": "#/$defs/nonEmptyString"},
        "retryable": {"type": "boolean"}
      }
    },
    "verifyTargetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "deckName", "modelName", "requiredFields"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "deckName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "modelName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "requiredFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalNonEmptyString"}
        }
      }
    },
    "verifyTargetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "deckId", "modelId", "fieldNames", "deckCreated"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "deckId": {"type": "integer", "minimum": 1},
        "modelId": {"type": "integer", "minimum": 1},
        "fieldNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalNonEmptyString"}
        },
        "deckCreated": {"type": "boolean"}
      }
    },
    "knownVocabularyScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "excludedDecks"],
      "properties": {
        "kind": {"const": "knownVocabulary"},
        "excludedDecks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalNonEmptyString"}
        }
      }
    },
    "duplicateScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modelName", "deckName", "candidateKeys"],
      "properties": {
        "kind": {"const": "duplicates"},
        "modelName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "deckName": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/canonicalNonEmptyString"}
          ]
        },
        "candidateKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/duplicateKey"}
        }
      }
    },
    "scanFirstFieldsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "scope"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "scope": {
          "oneOf": [
            {"$ref": "#/$defs/knownVocabularyScope"},
            {"$ref": "#/$defs/duplicateScope"}
          ]
        }
      }
    },
    "scanFirstFieldsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "firstFields"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "firstFields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "duplicateLookupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "matches"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "matches": {
          "$comment": "Positionally aligned with duplicateScope.candidateKeys; Kotlin maps AnkiDroid's SparseArray result indices to these booleans.",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"type": "boolean"}
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "sourcePath", "preferredName", "purpose", "mediaKind"],
      "properties": {
        "assetId": {"$ref": "#/$defs/assetId"},
        "sourcePath": {"type": "string", "pattern": "^/"},
        "preferredName": {
          "$comment": "Extensionless addMediaFromUri prefix; Python verifies it against the internal requested filename.",
          "$ref": "#/$defs/filename"
        },
        "purpose": {"enum": ["card", "dictionary"]},
        "mediaKind": {"enum": ["audio", "image"]}
      }
    },
    "storeMediaRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "assets"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/mediaAsset"}
        }
      }
    },
    "storedMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "status", "actualFilename"],
      "properties": {
        "assetId": {"$ref": "#/$defs/assetId"},
        "status": {"const": "stored"},
        "actualFilename": {"$ref": "#/$defs/filename"}
      }
    },
    "failedMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "status", "error"],
      "properties": {
        "assetId": {"$ref": "#/$defs/assetId"},
        "status": {"const": "failed"},
        "error": {
          "allOf": [
            {"$ref": "#/$defs/errorDetail"},
            {
              "type": "object",
              "properties": {"code": {"const": "media_store_failed"}}
            }
          ]
        }
      }
    },
    "storeMediaResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "results"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "results": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/storedMedia"},
              {"$ref": "#/$defs/failedMedia"}
            ]
          }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "fields", "tags"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/canonicalNonEmptyString"},
          "additionalProperties": {"type": "string"}
        },
        "tags": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "createNotesRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "deckName", "modelName", "notes"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "deckName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "modelName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/note"}
        }
      }
    },
    "createdNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "status", "noteId"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "status": {"const": "created"},
        "noteId": {"type": "integer", "minimum": 1}
      }
    },
    "duplicateNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "status"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "status": {"const": "duplicate"}
      }
    },
    "failedNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "status"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "status": {"const": "failed"}
      }
    },
    "notAttemptedNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "status"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "status": {"const": "notAttempted"}
      }
    },
    "createNotesResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "results", "error"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/createdNote"},
              {"$ref": "#/$defs/duplicateNote"},
              {"$ref": "#/$defs/failedNote"},
              {"$ref": "#/$defs/notAttemptedNote"}
            ]
          }
        },
        "error": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/errorDetail"}
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "operation", "code", "message", "retryable"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "operation": {"enum": ["verifyTarget", "scanFirstFields", "storeMedia", "createNotes"]},
        "code": {"$ref": "#/$defs/errorCode"},
        "message": {"$ref": "#/$defs/nonEmptyString"},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
