{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-miner.app/schemas/android-bridge/v1/anki.json",
  "title": "Anki Miner Android AnkiDroid callback payloads",
  "$comment": "Every callback is synchronous and returns an envelope. Responses repeat runId/requestId; media and note results are positionally aligned with requests. verifyTarget validates model/fields before creating the deck. Duplicate scans are bounded candidate-key lookups, never full-model scans. Kotlin returns raw provider first fields and Python alone applies the desktop duplicate normalizer. Media calls are bounded to 50 assets. Before a media callback, Python stat-gates card assets at 64 MiB, streams SHA-1/SHA-256 in cancellable 128 KiB chunks, and retains digests rather than file contents. preferredName is the safe extensionless prefix required by AnkiDroid addMediaFromUri; requestedFilename preserves the exact direct-fallback basename; actualFilename is a raw basename, never [sound:] or <img> markup, and Python rewrites marked dictionary HTML to the provider-returned name. Runtime validation additionally enforces aggregate duplicate-hit UTF-8/item budgets, provider-name relationships and collisions, unique positive note IDs, and a strict notAttempted suffix with a top-level error.",
  "oneOf": [
    {"$ref": "#/$defs/verifyTargetRequest"},
    {"$ref": "#/$defs/verifyTargetResult"},
    {"$ref": "#/$defs/scanFirstFieldsRequest"},
    {"$ref": "#/$defs/scanFirstFieldsResult"},
    {"$ref": "#/$defs/duplicateLookupResult"},
    {"$ref": "#/$defs/storeMediaRequest"},
    {"$ref": "#/$defs/storeMediaResult"},
    {"$ref": "#/$defs/createNotesRequest"},
    {"$ref": "#/$defs/createNotesResult"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "runId": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "requestId": {"type": "string", "pattern": "^anki_[0-9a-f]{32}$"},
    "assetId": {"type": "string", "pattern": "^asset_[0-9a-f]{32}$"},
    "clientNoteId": {"type": "string", "pattern": "^note_[0-9a-f]{32}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "canonicalNonEmptyString": {
      "type": "string",
      "minLength": 1,
      "$comment": "Runtime validation additionally enforces NFC and rejects every Unicode category-C code point.",
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]).+$"
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "$comment": "Runtime validation additionally enforces NFC, bare-basename semantics, and rejects every Unicode category-C code point.",
      "pattern": "^(?![.]{1,2}$)(?!\\s)(?!.*\\s$)(?!.*[/\\\\<>\\[\\]:\"\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]).+$"
    },
    "mediaBasename": {
      "type": "string",
      "minLength": 1,
      "$comment": "Exact media basename used by the direct-name fallback. Runtime validation rejects slash, backslash, dot-segments, and every Unicode category-C code point; valid Yomitan names may contain quotes, brackets, spaces, and non-NFC text.",
      "pattern": "^(?![.]{1,2}$)(?!.*[/\\\\\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]).+$"
    },
    "actualMediaBasename": {
      "allOf": [
        {"$ref": "#/$defs/mediaBasename"},
        {
          "$comment": "A callback returns the raw filename, never Anki field markup.",
          "pattern": "^(?!\\[sound:)(?!<img).+$"
        }
      ]
    },
    "duplicateKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "duplicateCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "firstField"],
      "properties": {
        "key": {"$ref": "#/$defs/duplicateKey"},
        "firstField": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "$comment": "Exact built first-field value. Kotlin computes AnkiDroid's field checksum from this value and returns the bounded raw provider hits. The key is an opaque Python-normalized identity; Kotlin must not normalize or compare against it."
        }
      }
    },
    "createDuplicateCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "firstField", "baselineNoteIds"],
      "properties": {
        "key": {
          "$ref": "#/$defs/duplicateKey",
          "$comment": "Opaque Python-normalized identity included for positional auditability. Kotlin must not normalize or interpret it."
        },
        "firstField": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "$comment": "Exact first field whose AnkiDroid checksum selects the provider note-ID snapshot."
        },
        "baselineNoteIds": {
          "$comment": "Complete scoped checksum-hit IDs returned by the immediately preceding duplicate probe for this exact candidate. Kotlin compares its pre-insert snapshot against this baseline; it does not compare raw field text.",
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "errorCode": {
      "enum": [
        "api_disabled",
        "permission_required",
        "note_type_not_found",
        "field_missing",
        "field_mapping_invalid",
        "target_invalid",
        "provider_unavailable",
        "query_failed",
        "write_failed",
        "timeout",
        "cancelled",
        "media_store_failed",
        "invalid_request",
        "unsupported_operation",
        "internal_error"
      ]
    },
    "errorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"$ref": "#/$defs/errorCode"},
        "message": {"$ref": "#/$defs/nonEmptyString"},
        "retryable": {"type": "boolean"}
      }
    },
    "verifyTargetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "deckName", "modelName", "requiredFields"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "deckName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "modelName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "requiredFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalNonEmptyString"}
        }
      }
    },
    "verifyTargetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "deckId", "modelId", "fieldNames", "deckCreated"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "deckId": {"type": "integer", "minimum": 1},
        "modelId": {"type": "integer", "minimum": 1},
        "fieldNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalNonEmptyString"}
        },
        "deckCreated": {"type": "boolean"}
      }
    },
    "knownVocabularyScope": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Kotlin scans at most maxScannedNotes notes in stable provider order. An excluded deck excludes the entire note when any of its cards is in that deck or a descendant; a parent exclusion therefore covers all subdecks. cursor is null on the first page and otherwise exactly the prior nextCursor. The token is opaque to Python; ordinal must advance by one per non-terminal page. Kotlin must fail rather than truncate or skip an oversized first field.",
      "required": ["kind", "excludedDecks", "cursor", "limits"],
      "properties": {
        "kind": {"const": "knownVocabulary"},
        "excludedDecks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalNonEmptyString"}
        },
        "cursor": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/knownVocabularyCursor"}
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxScannedNotes", "maxItems", "maxItemUtf8Bytes", "maxTotalUtf8Bytes"],
          "properties": {
            "maxScannedNotes": {"const": 256},
            "maxItems": {"const": 256},
            "maxItemUtf8Bytes": {"const": 65536},
            "maxTotalUtf8Bytes": {"const": 262144}
          }
        }
      }
    },
    "knownVocabularyCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "token"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "$comment": "Opaque provider continuation token. Runtime validation caps encoded UTF-8 length at 1024 bytes."
        }
      }
    },
    "duplicateScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modelName", "deckName", "candidates", "limits"],
      "properties": {
        "kind": {"const": "duplicates"},
        "modelName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "deckName": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/canonicalNonEmptyString"}
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/duplicateCandidate"}
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxHitsPerCandidate", "maxTotalHits", "maxItemUtf8Bytes", "maxTotalUtf8Bytes"],
          "properties": {
            "maxHitsPerCandidate": {"const": 100},
            "maxTotalHits": {"const": 1000},
            "maxItemUtf8Bytes": {"const": 65536},
            "maxTotalUtf8Bytes": {"const": 1048576}
          }
        }
      }
    },
    "scanFirstFieldsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "scope"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "scope": {
          "oneOf": [
            {"$ref": "#/$defs/knownVocabularyScope"},
            {"$ref": "#/$defs/duplicateScope"}
          ]
        }
      }
    },
    "scanFirstFieldsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "firstFields", "scannedNotes", "nextCursor"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "firstFields": {
          "type": "array",
          "maxItems": 256,
          "items": {"type": "string", "maxLength": 65536}
        },
        "scannedNotes": {"type": "integer", "minimum": 0, "maximum": 256},
        "nextCursor": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/knownVocabularyCursor"}
          ]
        }
      }
    },
    "duplicateLookupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "rawFirstFieldHits"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "rawFirstFieldHits": {
          "$comment": "Outer entries are positionally aligned with duplicateScope.candidates. Kotlin queries note IDs plus raw first fields by the checksum of each exact firstField and, when deckName is non-null, retains only notes with a card in that exact deck (never children). Note IDs are unique within each bucket. Kotlin must fail instead of truncating when any requested limit would be exceeded; Python validates every limit again, owns all HTML/media/entity/NFC/whitespace normalization, and carries the complete note-ID baseline into createNotes so a later snapshot can detect races without reimplementing normalization.",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["noteId", "firstField"],
              "properties": {
                "noteId": {"type": "integer", "minimum": 1},
                "firstField": {"type": "string", "maxLength": 65536}
              }
            }
          }
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "sourcePath", "preferredName", "requestedFilename", "purpose", "mediaKind"],
      "properties": {
        "assetId": {"$ref": "#/$defs/assetId"},
        "sourcePath": {"type": "string", "pattern": "^/"},
        "preferredName": {
          "$comment": "Safe extensionless addMediaFromUri prefix; dictionary media uses a deterministic digest alias.",
          "$ref": "#/$defs/filename"
        },
        "requestedFilename": {
          "$comment": "Exact full basename required by a direct-name media fallback. Card assets use safe content-addressed names; dictionary assets preserve valid Yomitan basenames.",
          "$ref": "#/$defs/mediaBasename"
        },
        "purpose": {"enum": ["card", "dictionary"]},
        "mediaKind": {"enum": ["audio", "image"]}
      }
    },
    "storeMediaRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "assets"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"$ref": "#/$defs/mediaAsset"}
        }
      }
    },
    "storedMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "status", "actualFilename"],
      "properties": {
        "assetId": {"$ref": "#/$defs/assetId"},
        "status": {"const": "stored"},
        "actualFilename": {"$ref": "#/$defs/actualMediaBasename"}
      }
    },
    "failedMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "status", "error"],
      "properties": {
        "assetId": {"$ref": "#/$defs/assetId"},
        "status": {"const": "failed"},
        "error": {
          "allOf": [
            {"$ref": "#/$defs/errorDetail"},
            {
              "type": "object",
              "properties": {"code": {"const": "media_store_failed"}}
            }
          ]
        }
      }
    },
    "storeMediaResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "results"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/storedMedia"},
              {"$ref": "#/$defs/failedMedia"}
            ]
          }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "fields", "tags", "duplicateCandidate"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/canonicalNonEmptyString"},
          "additionalProperties": {"type": "string"}
        },
        "tags": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "duplicateCandidate": {"$ref": "#/$defs/createDuplicateCandidate"}
      }
    },
    "collectionCreateDuplicateScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "limits"],
      "properties": {
        "kind": {"const": "collection"},
        "limits": {"$ref": "#/$defs/createSnapshotLimits"}
      }
    },
    "exactDeckCreateDuplicateScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "deckName", "includeChildren", "limits"],
      "properties": {
        "kind": {"const": "exactDeck"},
        "deckName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "includeChildren": {"const": false},
        "limits": {"$ref": "#/$defs/createSnapshotLimits"}
      }
    },
    "createSnapshotLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxNoteIdsPerCandidate", "maxTotalNoteIds"],
      "properties": {
        "maxNoteIdsPerCandidate": {"const": 100},
        "maxTotalNoteIds": {"const": 1000}
      }
    },
    "createNotesRequest": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Kotlin resolves every candidate's scoped checksum note IDs before inserting any note. A note is duplicate iff that pre-insert snapshot contains an ID absent from its baselineNoteIds. maxTotalNoteIds counts the union of IDs across candidates, so position-faithful repeated candidates do not consume the budget repeatedly. Kotlin fails rather than truncating on the declared limits. It must never add IDs created by this same request to the snapshot, so repeated same-expression notes in exactDeck mode are all created when no external ID appeared. A new checksum collision may safely false-positive; a new external note must never false-negative. The exactDeck deckName must equal the top-level target deck at runtime.",
      "required": ["runId", "requestId", "deckName", "modelName", "duplicateScope", "notes"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "deckName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "modelName": {"$ref": "#/$defs/canonicalNonEmptyString"},
        "duplicateScope": {
          "oneOf": [
            {"$ref": "#/$defs/collectionCreateDuplicateScope"},
            {"$ref": "#/$defs/exactDeckCreateDuplicateScope"}
          ]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/note"}
        }
      }
    },
    "createdNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "status", "noteId"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "status": {"const": "created"},
        "noteId": {"type": "integer", "minimum": 1}
      }
    },
    "duplicateNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "status"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "status": {"const": "duplicate"}
      }
    },
    "failedNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "status"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "status": {"const": "failed"}
      }
    },
    "notAttemptedNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientNoteId", "status"],
      "properties": {
        "clientNoteId": {"$ref": "#/$defs/clientNoteId"},
        "status": {"const": "notAttempted"}
      }
    },
    "createNotesResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "results", "error"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/createdNote"},
              {"$ref": "#/$defs/duplicateNote"},
              {"$ref": "#/$defs/failedNote"},
              {"$ref": "#/$defs/notAttemptedNote"}
            ]
          }
        },
        "error": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/errorDetail"}
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "requestId", "operation", "code", "message", "retryable"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "operation": {"enum": ["verifyTarget", "scanFirstFields", "storeMedia", "createNotes"]},
        "code": {"$ref": "#/$defs/errorCode"},
        "message": {"$ref": "#/$defs/nonEmptyString"},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
