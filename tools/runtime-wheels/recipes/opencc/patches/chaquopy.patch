+def build_host_tools():
+    """Chaquopy: build opencc_dict and opencc for the build machine.
+
+    The cross build compiles its .ocd2 dictionaries with these, because the
+    target executables cannot run here. Only the dictionaries reach the wheel.
+    """
+    host_dir = os.path.join(_this_dir, 'build', 'host')
+    env = {key: os.environ[key] for key in
+           ('PATH', 'HOME', 'TMPDIR', 'LANG', 'LC_ALL', 'TZ', 'SOURCE_DATE_EPOCH')
+           if key in os.environ}
+    cxx = shutil.which('c++', path=os.defpath)
+    assert cxx, 'no host C++ compiler on ' + os.defpath
+    cmd = ['cmake', '-S', _this_dir, '-B', host_dir,
+           '-DCMAKE_CXX_COMPILER={}'.format(cxx),
+           '-DCMAKE_BUILD_TYPE=Release',
+           '-DBUILD_SHARED_LIBS:BOOL=OFF',
+           '-DBUILD_PYTHON:BOOL=OFF',
+           '-DENABLE_GTEST:BOOL=OFF',
+           '-DENABLE_BENCHMARK:BOOL=OFF',
+           '-DBUILD_DOCUMENTATION:BOOL=OFF',
+           '-DBUILD_OPENCC_JIEBA_PLUGIN:BOOL=OFF',
+           '-DPYTHON_EXECUTABLE={}'.format(sys.executable)]
+    assert subprocess.call(cmd, env=env) == 0, 'Host configure failed'
+    cmd = ['cmake', '--build', host_dir, '--parallel', os.environ.get('CPU_COUNT', '4'),
+           '--target', 'opencc_dict', 'opencc']
+    assert subprocess.call(cmd, env=env) == 0, 'Host build failed'
+    return os.path.join(host_dir, 'src', 'tools')
+
+
